# Ported from https://github.com/cetanu/dotfiles.
# Dropped [sequence] editor = interactive-rebase-tool (niche tool we skipped) —
# rebase -i now falls back to core.editor (nvim) instead.
[user]
    name = Suvadeep Ghoshal
    email = ghoshalsuvadeep594@gmail.com

[core]
    editor = nvim
    pager = delta

[format]
    pretty = format:%C(Cyan)%h %C(reset)%s

[interactive]
    diffFilter = delta --color-only

[delta]
    features = side-by-side line-numbers decorations
    whitespace-error-style = 22 reverse

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none

[pull]
    rebase = true

[init]
    defaultBranch = master
