# Ghostty config — symlinked to ~/.config/ghostty/config.ghostty by setup.sh.
# Reload with cmd+shift+, (macOS) or ctrl+shift+, (Linux). See all options: `ghostty +show-config --default --docs`.

# Tokyo Night (built into Ghostty). Other variants: "TokyoNight Storm", "TokyoNight Moon", "TokyoNight Day".
theme = TokyoNight

font-family = JetBrainsMono Nerd Font
font-size = 14

shell-integration = detect
window-padding-x = 4
window-padding-y = 4
